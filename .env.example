# Turso Database (free SQLite in the cloud)
# Get these from https://turso.tech (sign up, create a database, copy values)
TURSO_DATABASE_URL=libsql://your-db-name-hash.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Optional: for local development only
# Leave blank for production (Vercel will fill these)

# Signs login sessions. REQUIRED in production (at least 32 characters) - the
# app refuses to run without it. Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-string

# Optional: `npm run db:migrate` creates (or promotes) this admin account.
# Never commit real values.
ADMIN_USERNAME=walli
ADMIN_PASSWORD=change-me

# Lets the automated expense-sync routine authenticate against /api/expenses
# without a session (see src/lib/auth.ts verifyRoutineSecret).
ROUTINE_SECRET=change-me-to-a-random-string

# Authenticates Vercel Cron's daily call to /api/cron/daily, which sends email
# reminders and on the last day of each month adds the "Subscriptions" expense. Vercel automatically
# sends this value as `Authorization: Bearer $CRON_SECRET` when it's set on the
# project — set the same value here for local testing. Generate one with:
# openssl rand -hex 32
CRON_SECRET=change-me-to-a-random-string

# The in-app assistant (src/lib/assistant.ts). Free key from Google AI Studio.
# Leave GEMINI_MODEL empty to use the newest stable Flash model the key can access.
GEMINI_API_KEY=
GEMINI_MODEL=

# Email reminders (src/lib/mailer.ts), sent free through Gmail. GMAIL_USER is
# the Gmail address they come from; GMAIL_APP_PASSWORD is an app password from
# https://myaccount.google.com/apppasswords (needs 2-step verification).
# Leave both empty to switch reminders off.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Link used in reminder emails.
APP_URL=https://khata-delta.vercel.app
