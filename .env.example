# Turso Database (free SQLite in the cloud)
# Get these from https://turso.tech (sign up, create a database, copy values)
TURSO_DATABASE_URL=libsql://your-db-name-hash.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Optional: for local development only
# Leave blank for production (Vercel will fill these)

# Auth session signing secret — set a long random string in production
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-string

# Hard-coded admin account — always exists on startup with this username/password.
# Set these in Vercel (do not commit real values). If unset, falls back to
# walli / 821202 for local development only.
ADMIN_USERNAME=walli
ADMIN_PASSWORD=change-me

# Lets the automated expense-sync routine authenticate against /api/expenses
# without a session (see src/lib/auth.ts verifyRoutineSecret).
ROUTINE_SECRET=change-me-to-a-random-string

# Authenticates Vercel Cron's daily call to /api/cron/subscription-reminders
# (the WhatsApp due-date reminders). Vercel automatically sends this value as
# `Authorization: Bearer $CRON_SECRET` when it's set on the project — set the
# same value here for local testing. Generate one with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-random-string

# Meta WhatsApp Cloud API — sends the subscription due-date reminders (see
# src/lib/whatsapp.ts). Get these from a Meta Developer App with the
# WhatsApp product added: WHATSAPP_PHONE_NUMBER_ID is the sending number's
# ID, WHATSAPP_ACCESS_TOKEN is a permanent token from a System User. Also
# requires a "subscription_due_reminder" message template approved in
# WhatsApp Manager (category: Utility) with body:
#   "Reminder: your {{1}} subscription of {{2}} is due {{3}}."
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
